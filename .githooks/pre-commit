#!/bin/sh
# Format, organize imports and apply safe lint fixes to the staged files, then stage the result.
# What Biome cannot fix blocks the commit.
set -eu

# Re-staging a partly staged file would commit its unstaged edits too.
if git status --porcelain | grep -q '^[MARC]M'; then
  echo "pre-commit: some staged files also have unstaged changes; stage or stash them first" >&2
  exit 1
fi

# A GUI git client runs hooks without the login shell's PATH, so Bun's own install is looked for too.
PATH="$PATH:${BUN_INSTALL:-$HOME/.bun}/bin"
if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found on PATH or in ${BUN_INSTALL:-$HOME/.bun}/bin" >&2
  exit 1
fi

bun x biome check --write --staged --files-ignore-unknown=true --no-errors-on-unmatched
git update-index --again
