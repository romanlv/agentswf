{
  "name": "@agentswf/engine",
  "version": "0.1.0",
  "description": "agents.wf: the engine that runs workflows made of coding agents",
  "license": "MIT",
  "homepage": "https://agents.wf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romanlv/agentswf.git",
    "directory": "packages/engine"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./typebox": "./src/author-typebox.ts",
    "./workflow-testing": "./src/workflow-testing/index.ts",
    "./cli": "./src/operator-cli.ts",
    "./hand-over": "./src/hand-over.ts",
    "./client": "./src/client/published.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.eval.ts",
    "!src/**/*.typecheck.ts",
    "!src/**/*.fixture.ts",
    "!src/**/fixtures",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@agentswf/contract": "workspace:*",
    "@agentswf/harness": "workspace:*",
    "@agentswf/sandbox": "workspace:*",
    "typebox": "^1.3.34"
  },
  "publishConfig": {
    "access": "public"
  }
}
