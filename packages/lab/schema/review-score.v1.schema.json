                                "finding": {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                "label": {
                                  "type": "string",
                                  "const": "new"
                                },
                                "why": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "read": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "required": ["path", "start", "end"],
                                    "properties": {
                                      "path": {
                                        "type": "string",
                                        "minLength": 1
                                      },
                                      "start": {
                                        "type": "integer",
                                        "minimum": 1
                                      },
                                      "end": {
                                        "type": "integer",
                                        "minimum": 1
                                      }
                                    },
                                    "additionalProperties": false,
                                    "description": "Lines the judge read in the frozen code."
                                  }
                                },
                                "severity": {
                                  "enum": ["must-fix", "should-fix", "could-fix", "nit"]
                                },
                                "category": {
                                  "enum": [
                                    "correctness",
                                    "security",
                                    "performance",
                                    "tests",
                                    "design",
                                    "maintainability",
                                    "docs-style",
                                    "slop"
                                  ]
                                },
                                "scope": {
                                  "enum": ["change", "context"],
                                  "description": "Whether the MR caused it or it was already there, as a key issue says."
                                },
                                "mechanism": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "As a key issue gives one."
                                }
                              },
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "required": ["finding", "label", "why", "read", "refutes"],
