{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "awf-lab trial",
  "type": "object",
  "required": ["format", "id", "at", "variant", "dataset", "case", "restoreMs", "run", "findings"],
  "properties": {
    "format": {
      "type": "string",
      "const": "awf.review-findings/2"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z-]+$",
      "description": "This trial's own id, its folder's name; the run may never have started."
    },
    "at": {
      "type": "string",
      "minLength": 1,
      "description": "ISO 8601"
    },
    "variant": {
      "type": "object",
      "required": ["name", "version", "commit"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "description": "The semver its file declared; results belong to its {major}.{minor}."
        },
        "commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "The file's repository at HEAD; null outside git."
        },
        "dirty": {
          "type": "boolean",
          "description": "Written by earlier versions of awf-lab; never read."
        }
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "case": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "restoreMs": {
      "type": "integer",
      "minimum": 0
    },
    "sandbox": {
      "anyOf": [
        {
          "type": "object",
          "required": ["srt"],
          "properties": {
            "srt": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["docker"],
          "properties": {
            "docker": {
              "type": "object",
              "properties": {
                "image": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["container"],
          "properties": {
            "container": {
              "type": "object",
              "required": ["image"],
              "properties": {
                "image": {
                  "type": "string",
                  "minLength": 1,
                  "description": "An image holding bun, git and codex: the docker provider's default."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "The sandbox setting awf-lab gave the run, from awf-lab.json, which every agent ran in; a trial counts only while it is the workspace's. Absent: the run had none.",
      "~optional": true
    },
    "run": {
      "type": "object",
      "required": ["outcome", "models", "ms", "billing", "complete"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Absent when the run never started."
        },
        "outcome": {
          "enum": ["succeeded", "stopped", "failed", "cancelled", "timed-out"]
        },
        "error": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Every model its agents and decisions used, so a family can be told apart."
        },
        "ms": {
          "type": "integer",
          "minimum": 0
        },
        "estimate": {
          "type": "number",
          "minimum": 0,
          "description": "USD at list price, agents and decisions."
        },
        "charged": {
          "type": "number",
          "minimum": 0
        },
        "billing": {
          "enum": ["subscription", "metered", "unknown", "mixed"]
        },
        "complete": {
          "type": "boolean",
          "description": "Every agent's usage was known and priced."
        }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "string",
      "minLength": 1,
      "description": "Why there are no findings to judge: the run did not succeed, or its variant's read failed."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "What a person reading the review would read; words are counted over it."
          },
          "severity": {
            "type": "string",
            "description": "The reviewer's own word for it."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "description": "One attempt by a variant at one case: its run, and the findings its variant read from it, verbatim."
}
