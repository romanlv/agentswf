                            "design",
                            "maintainability",
                            "docs-style",
                            "slop"
                          ]
                        },
                        "scope": {
                          "enum": ["change", "context"],
                          "description": "Whether the MR caused it or it was already there, as a key issue says."
                        },
                        "mechanism": {
                          "type": "string",
                          "minLength": 1,
                          "description": "As a key issue gives one."
                        }
