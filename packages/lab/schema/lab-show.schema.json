                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["finding", "label", "why", "read"],
                      "properties": {
                        "finding": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "label": {
                          "type": "string",
