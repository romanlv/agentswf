                        },
                        "why": {
                          "type": "string",
                          "minLength": 1
                        },
                        "read": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["path", "start", "end"],
                            "properties": {
                              "path": {
                                "type": "string",
                                "minLength": 1
                              },
                              "start": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "end": {
                                "type": "integer",
                                "minimum": 1
                              }
                            },
                            "additionalProperties": false,
                            "description": "Lines the judge read in the frozen code."
                          }
                        },
                        "refutes": {
                          "type": "string",
                          "minLength": 1,
                          "description": "The code fact that shows it false."
                        },
                        "symptomOf": {
                          "type": "string",
                          "pattern": "^K[0-9]+$"
                        },
                        "repeats": {
                          "type": "string",
