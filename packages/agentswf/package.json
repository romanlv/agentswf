{
  "name": "agentswf",
  "version": "0.1.0",
  "description": "agents.wf: an engine that runs workflows made of coding agents. Gives you awf, agentswf/workflow, agentswf/typebox, agentswf/testing and agentswf/client",
  "license": "MIT",
  "homepage": "https://agents.wf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romanlv/agentswf.git",
    "directory": "packages/agentswf"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "awf": "./src/awf.ts"
  },
  "exports": {
    "./workflow": "./src/workflow.ts",
    "./testing": "./src/testing.ts",
    "./typebox": "./src/typebox.ts",
    "./client": "./src/client.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.eval.ts",
    "!src/**/*.typecheck.ts",
    "!src/**/*.fixture.ts",
    "!src/**/fixtures",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@agentswf/contract": "workspace:*",
    "@agentswf/engine": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agents",
    "workflow",
    "coding-agents",
    "claude",
    "codex"
  ]
}
