{
  "name": "agentswf",
  "version": "0.1.0-beta.0",
  "description": "agents.wf: an engine that runs workflows made of coding agents. Gives you awf and agentswf/workflow",
  "license": "MIT",
  "homepage": "https://github.com/romanlv/agentswf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romanlv/agentswf.git",
    "directory": "packages/agentswf"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "awf": "./src/awf.ts"
  },
  "exports": {
    "./workflow": "./src/workflow.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "dependencies": {
    "@agentswf/contract": "workspace:*",
    "@agentswf/engine": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agents",
    "workflow",
    "coding-agents",
    "claude",
    "codex"
  ]
}
