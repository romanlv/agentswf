{
  "name": "@agentswf/contract",
  "version": "0.1.0-beta.0",
  "description": "agents.wf: types, schemas and record formats shared by its packages",
  "license": "MIT",
  "homepage": "https://github.com/romanlv/agentswf",
  "repository": {
    "type": "git",
