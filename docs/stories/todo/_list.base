views:
  - type: table
    name: By priority
    filters:
      and:
        - file.inFolder("stories/todo")
        - file.name != "README"
        - '!file.name.startsWith("_")'
    order:
      - priority
      - epic
      - file.name
      - type
      - depends_on
    sort:
      - property: priority
        direction: ASC
      - property: epic
        direction: ASC
    columnSize:
      file.name: 260
  - type: table
    name: By epic
    filters:
      and:
        - file.inFolder("stories/todo")
        - file.name != "README"
    order:
      - epic
      - priority
      - file.name
      - type
      - depends_on
    sort:
      - property: epic
        direction: ASC
      - property: priority
        direction: ASC
    columnSize:
      file.name: 260
