{
  "name": "awf",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples",
      "experiments/*"
    ],
    "catalog": {
      "typescript": "^5.9.3",
      "@types/bun": "^1.3.4"
    }
  },
  "scripts": {
    "awf": "bun packages/engine/src/operator-cli.ts",
    "check": "biome check . && tsc --noEmit && bun run scripts/check-boundaries.ts",
    "format": "biome check --write .",
    "lint": "biome check .",
    "test": "bun test",
    "ts-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
