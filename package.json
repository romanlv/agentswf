{
  "name": "awf",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples",
      "experiments/*"
    ],
    "catalog": {
      "typescript": "^5.9.3",
      "@types/bun": "^1.3.4"
    }
  },
  "scripts": {
    "awf": "bun packages/engine/src/operator-cli.ts",
    "check": "biome check . && tsc --noEmit && bun run scripts/check-boundaries.ts",
    "eval": "bun scripts/eval.ts",
    "format": "biome check --write .",
    "prepare": "git config core.hooksPath .githooks",
    "release": "for p in contract sandbox harness wf engine agentswf; do (cd packages/$p && bun publish --tag beta) || exit 1; done",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
